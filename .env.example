# --- Core ---
NODE_ENV=development
PORT=4000

# --- Auth (REQUIRED in production) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MongoDB ---
MONGO_URI=mongodb://developersnncmys_db_user:OIxdtSRd7EaXa8gh@ac-vmvy2nc-shard-00-00.zpucjki.mongodb.net:27017,ac-vmvy2nc-shard-00-01.zpucjki.mongodb.net:27017,ac-vmvy2nc-shard-00-02.zpucjki.mongodb.net:27017/?ssl=true&replicaSet=atlas-1pksjf-shard-0&authSource=admin&appName=Cluster0
