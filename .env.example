# --- Redis (optional; falls back to in-memory cache if off/unreachable) ---
# REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
# CACHE_PRODUCT_LIST_TTL=60
# CACHE_PRODUCT_DETAIL_TTL=300

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- Request limits ---
# REQUEST_TIMEOUT_MS=15000
# JSON_LIMIT=1mb
# RATE_WINDOW_MS=60000
# RATE_MAX=120
# RATE_AUTH_MAX=10

# --- Razorpay (optional; mock mode if disabled or keys missing) ---
# RAZORPAY_ENABLED=false
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Email (optional; no-op if disabled) ---
